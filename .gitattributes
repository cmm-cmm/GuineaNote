* text=auto eol=lf
# Preserve intentional Markdown hard line breaks in the supplied specification.
*.md whitespace=-blank-at-eol
# Byte-for-byte file fixtures must never be normalized by Git.
tests/fixtures/** -text
# Preserve control bytes and native line endings in raw PTY captures.
docs/diagnostics/**/*.log binary
# This evidence bundle carries SHA256 for original captured bytes, including
# native newlines in CSV/JSON/tool output. Keep checkout bytes reproducible.
docs/diagnostics/terminal-workflow/** -text -whitespace
docs/diagnostics/cli-migration/** -text -whitespace
docs/diagnostics/latency50/** -text -whitespace
docs/diagnostics/ascii-layout/** -text -whitespace
